{
  "name": "learnova",
  "version": "1.0.0",
  "private": true,
  "description": "Learnova — a modern, production-quality educational SaaS platform.",
  "author": "Learnova Engineering",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @learnova/config -w @learnova/shared -w @learnova/auth -w @learnova/database",
    "dev:api": "npm run dev -w @learnova/api",
    "dev:web": "npm run dev -w @learnova/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w @learnova/database",
    "db:migrate": "npm run db:migrate -w @learnova/database",
    "db:push": "npm run db:push -w @learnova/database",
    "db:seed": "npm run db:seed -w @learnova/database",
    "db:studio": "npm run db:studio -w @learnova/database",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.next apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3"
  }
}
