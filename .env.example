# ============================================================================
# Learnova — Environment configuration (copy to .env and fill values)
# ============================================================================

# --- Runtime ---
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learnova

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback

# --- OAuth: GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/github/callback

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Learnova <onboarding@resend.dev>"

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxx
# Local: copy the whsec_ printed by `stripe listen` (NOT the Dashboard endpoint secret).
# Production: use the signing secret from the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Must be a Price id (price_…), not a Product id (prod_…).
STRIPE_PRO_PRICE_ID=price_xxx

# --- ImageKit (images) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# --- Mux (secure video) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE_KEY=

# --- AI providers ---
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Web (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
